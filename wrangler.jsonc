{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "web-app23",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "ba9adbf8-e3c9-4ed9-a8b0-b0d007ce37ed","database_name": "web-app23" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "e2ac031bbf054babad513e7311aa5966" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
